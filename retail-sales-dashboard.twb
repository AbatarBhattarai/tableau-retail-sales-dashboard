      <column caption='Order ID' datatype='string' name='[order_id]' role='dimension' type='nominal' />
      <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
      <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
      <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
      <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
      <column caption='Product' datatype='string' name='[product]' role='dimension' type='nominal' />
      <column caption='Unit Price' datatype='real' name='[unit_price]' role='measure' type='quantitative' />
      <column caption='Quantity' datatype='integer' name='[quantity]' role='measure' type='quantitative' />
      <column caption='Discount' datatype='real' name='[discount]' role='measure' type='quantitative' />
      <column caption='Customer ID' datatype='string' name='[customer_id]' role='dimension' type='nominal' />
      <column caption='Revenue' datatype='real' name='[revenue]' role='measure' type='quantitative' />
      <column caption='Total Revenue' datatype='real' name='[Calculation_8471001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_8471002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([order_id])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_8471003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_8471001] / [Calculation_8471002]' />
      </column>
      <column caption='Month' datatype='date' name='[Calculation_8471004]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula="DATETRUNC('month', [order_date])" />
      </column>
      <column caption='MoM Revenue Change %' datatype='real' name='[Calculation_8471005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([revenue]) - LOOKUP(SUM([revenue]), -1)) / ABS(LOOKUP(SUM([revenue]), -1))' />
      </column>
      <column caption='Category Share %' datatype='real' name='[Calculation_8471006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue]) / TOTAL(SUM([revenue]))' />
      </column>
      <aliases enabled='yes' />
    </datasource>
  </datasources>
